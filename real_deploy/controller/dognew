#!/usr/bin/env bash
set -euo pipefail
RCDOG_NEW_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
export DOG_MOTION_ROOT="$RCDOG_NEW_ROOT"
export PYTHONPATH="$RCDOG_NEW_ROOT${PYTHONPATH:+:$PYTHONPATH}"
RCDOG_PYTHON=${RCDOG_PYTHON:-"$RCDOG_NEW_ROOT/.venv/bin/python"}
if [[ ! -x "$RCDOG_PYTHON" ]]; then RCDOG_PYTHON=$(command -v python3); fi
if [[ "${1:-}" == "serve" && "${RCDOG_LIMIT_CLASH_UI:-0}" == "1" ]]; then
    "$RCDOG_PYTHON" "$RCDOG_NEW_ROOT/tools/limit_clash_ui_cpu.py"
fi
exec "$RCDOG_PYTHON" "$RCDOG_NEW_ROOT/tools/deploy_newurdf.py" "$@"
