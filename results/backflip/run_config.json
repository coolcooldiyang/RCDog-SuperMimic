{
  "run": {
    "algo": "supermimic",
    "task": "RPOSuperMimic",
    "sim_backend": "mjwarp",
    "device": "cuda:0",
    "collector_tensor_device": null,
    "seed": {
      "configured_seed": 0,
      "configured_seed_source": "algo.seed",
      "effective_seed": 0
    },
    "init_checkpoint": "initializers/rpo_backflip_v1_last.pt"
  },
  "config": {
    "algo": {
      "algo": "supermimic",
      "algo_log_name": "supermimic",
      "load_run": "-1",
      "checkpoint": -1,
      "resume": false,
      "seed": 0,
      "num_envs": 1024,
      "iterations": 12000,
      "buffer_steps": 1000,
      "utd": 0.4,
      "horizon": 32,
      "goal_frames": 10,
      "hist": 10,
      "z_dim": 32,
      "wm_hidden": [
        1024,
        1024,
        1024
      ],
      "policy_hidden": [
        1024,
        512,
        256,
        128
      ],
      "critic_hidden": [
        256,
        128
      ],
      "wm_window": 8,
      "wm_batches": 10,
      "wm_batch": 1024,
      "pi_batch": 1024,
      "lr": 0.0002,
      "gamma": 0.99,
      "lam": 0.95,
      "action_noise": 0.1,
      "critic_epochs": 5,
      "critic_minibatches": 4,
      "no_critic": false,
      "warmup_steps": 64,
      "wm_only_iters": 500,
      "lr_decay_iters": 250000,
      "ckpt_every": 500,
      "log_every": 25,
      "log_backend": "tensorboard",
      "amp": "bf16",
      "compile": true,
      "test_hidden_dims": null
    },
    "training": {
      "task_name": "RPOSuperMimic",
      "sim_backend": "mjwarp",
      "collector_tensor_device": "auto",
      "play_only": false,
      "no_play": true,
      "sim2sim_strict": true,
      "play_render_mode": "none",
      "play_env_num": 40,
      "log_root": null,
      "log_dir": "runs/rpo_backflip_v2",
      "init_checkpoint": "initializers/rpo_backflip_v1_last.pt"
    },
    "env": {
      "seed": null,
      "scene": {
        "model_file": "src/unisupermimic/assets/robots/rpo/scene_supermimic_coupled.xml",
        "default_keyframe_name": "stand",
        "entities": {
          "robot": {
            "root_body_name": "base_link",
            "joint_names": [
              "left_thigh_yaw_joint",
              "left_thigh_roll_joint",
              "left_thigh_pitch_joint",
              "left_knee_joint",
              "left_ankle_pitch_joint",
              "left_ankle_roll_joint",
              "right_thigh_yaw_joint",
              "right_thigh_roll_joint",
              "right_thigh_pitch_joint",
              "right_knee_joint",
              "right_ankle_pitch_joint",
              "right_ankle_roll_joint",
              "torso_joint",
              "left_arm_pitch_joint",
              "left_arm_roll_joint",
              "left_arm_yaw_joint",
              "left_elbow_pitch_joint",
              "left_elbow_yaw_joint",
              "right_arm_pitch_joint",
              "right_arm_roll_joint",
              "right_arm_yaw_joint",
              "right_elbow_pitch_joint",
              "right_elbow_yaw_joint"
            ],
            "actuator_names": [
              "left_thigh_yaw_joint",
              "left_thigh_roll_joint",
              "left_thigh_pitch_joint",
              "left_knee_joint",
              "left_ankle_pitch_joint",
              "left_ankle_roll_joint",
              "right_thigh_yaw_joint",
              "right_thigh_roll_joint",
              "right_thigh_pitch_joint",
              "right_knee_joint",
              "right_ankle_pitch_joint",
              "right_ankle_roll_joint",
              "torso_joint",
              "left_arm_pitch_joint",
              "left_arm_roll_joint",
              "left_arm_yaw_joint",
              "left_elbow_pitch_joint",
              "left_elbow_yaw_joint",
              "right_arm_pitch_joint",
              "right_arm_roll_joint",
              "right_arm_yaw_joint",
              "right_elbow_pitch_joint",
              "right_elbow_yaw_joint"
            ],
            "body_names": [
              "base_link",
              "left_thigh_roll_link",
              "left_knee_link",
              "left_ankle_roll_link",
              "right_thigh_roll_link",
              "right_knee_link",
              "right_ankle_roll_link",
              "torso_link",
              "left_arm_roll_link",
              "left_elbow_pitch_link",
              "left_elbow_yaw_link",
              "right_arm_roll_link",
              "right_elbow_pitch_link",
              "right_elbow_yaw_link"
            ]
          },
          "ground": {
            "geom_names": [
              "floor"
            ]
          }
        }
      },
      "sim_dt": 0.004,
      "ctrl_dt": 0.02,
      "max_episode_seconds": 10.0,
      "auto_reset": true,
      "scale_rewards_by_dt": false,
      "observations": {
        "policy": {
          "enable_corruption": false,
          "terms": {
            "obs": {
              "func": "unisupermimic.tasks.motion_tracking.rpo.supermimic.manager_terms.supermimic_obs",
              "params": {
                "command_name": "motion"
              }
            }
          }
        },
        "future": {
          "enable_corruption": false,
          "terms": {
            "goal": {
              "func": "unisupermimic.tasks.motion_tracking.rpo.supermimic.manager_terms.supermimic_goal",
              "params": {
                "command_name": "motion",
                "num_frames": 10
              }
            }
          }
        }
      },
      "actions": {
        "joint_pos": {
          "_target_": "unisupermimic.tasks.motion_tracking.rpo.supermimic.manager_terms.SuperMimicActionCfg",
          "entity_name": "robot",
          "command_name": "motion"
        }
      },
      "commands": {
        "motion": {
          "_target_": "unisupermimic.tasks.motion_tracking.rpo.supermimic.manager_terms.SuperMimicCommandCfg",
          "entity_name": "robot",
          "mjcf_path": "src/unisupermimic/assets/robots/rpo/supermimic_coupled.xml",
          "eval_mode": false,
          "gamma": 0.99,
          "src_fps": 50,
          "reset_noise": true,
          "max_episode_steps": 500,
          "goal_frames": 10,
          "context_dim": 27,
          "resampling_time_range": [
            1000000000.0,
            1000000000.0
          ],
          "motion_files": [
            "src/unisupermimic/assets/motions/rpo/backflip_reference.csv"
          ]
        }
      },
      "events": {
        "startup_context": {
          "_target_": "unilab.managers.EventTermCfg",
          "func": "unisupermimic.tasks.motion_tracking.rpo.supermimic.manager_terms.SuperMimicContextEvent",
          "mode": "startup",
          "params": {
            "command_name": "motion",
            "asset_cfg": {
              "_target_": "unilab.managers.SceneEntityCfg",
              "name": "robot"
            },
            "ground_asset_cfg": {
              "_target_": "unilab.managers.SceneEntityCfg",
              "name": "ground",
              "geom_names": [
                "floor"
              ]
            }
          }
        },
        "reset_context": {
          "_target_": "unilab.managers.EventTermCfg",
          "func": "unisupermimic.tasks.motion_tracking.rpo.supermimic.manager_terms.SuperMimicContextEvent",
          "mode": "reset",
          "params": {
            "command_name": "motion",
            "asset_cfg": {
              "_target_": "unilab.managers.SceneEntityCfg",
              "name": "robot"
            },
            "ground_asset_cfg": {
              "_target_": "unilab.managers.SceneEntityCfg",
              "name": "ground",
              "geom_names": [
                "floor"
              ]
            }
          }
        },
        "joint_offsets": {
          "_target_": "unilab.managers.EventTermCfg",
          "func": "unisupermimic.tasks.motion_tracking.rpo.supermimic.manager_terms.SuperMimicJointOffsetEvent",
          "mode": "reset",
          "params": {
            "command_name": "motion"
          }
        }
      },
      "terminations": {
        "hard": {
          "_target_": "unilab.managers.TerminationTermCfg",
          "func": "unisupermimic.tasks.motion_tracking.rpo.supermimic.manager_terms.supermimic_termination",
          "params": {
            "command_name": "motion"
          }
        },
        "timeout": {
          "_target_": "unilab.managers.TerminationTermCfg",
          "func": "unisupermimic.tasks.motion_tracking.rpo.supermimic.manager_terms.supermimic_timeout",
          "time_out": true,
          "params": {
            "command_name": "motion"
          }
        },
        "clip_end": {
          "_target_": "unilab.managers.TerminationTermCfg",
          "func": "unisupermimic.tasks.motion_tracking.rpo.supermimic.manager_terms.supermimic_clip_end",
          "time_out": true,
          "params": {
            "command_name": "motion"
          }
        }
      },
      "policy_observation_group": "policy",
      "critic_observation_group": "future",
      "mjwarp_nconmax": 128,
      "mjwarp_njmax": 500
    },
    "reward": {
      "tracking": {
        "_target_": "unilab.managers.RewardTermCfg",
        "func": "unisupermimic.tasks.motion_tracking.rpo.supermimic.manager_terms.supermimic_reward",
        "weight": 1.0,
        "params": {
          "command_name": "motion"
        }
      }
    }
  },
  "contract_snapshot": {
    "env.observations": {
      "policy": {
        "enable_corruption": false,
        "terms": {
          "obs": {
            "func": "unisupermimic.tasks.motion_tracking.rpo.supermimic.manager_terms.supermimic_obs",
            "params": {
              "command_name": "motion"
            }
          }
        }
      },
      "future": {
        "enable_corruption": false,
        "terms": {
          "goal": {
            "func": "unisupermimic.tasks.motion_tracking.rpo.supermimic.manager_terms.supermimic_goal",
            "params": {
              "command_name": "motion",
              "num_frames": 10
            }
          }
        }
      }
    },
    "env.actions": {
      "joint_pos": {
        "_target_": "unisupermimic.tasks.motion_tracking.rpo.supermimic.manager_terms.SuperMimicActionCfg",
        "entity_name": "robot",
        "command_name": "motion"
      }
    },
    "env.policy_observation_group": "policy",
    "env.critic_observation_group": "future",
    "env.ctrl_dt": 0.02,
    "env.scene.model_file": "src/unisupermimic/assets/robots/rpo/scene_supermimic_coupled.xml",
    "algo.goal_frames": 10,
    "algo.hist": 10,
    "algo.z_dim": 32,
    "algo.wm_hidden": [
      1024,
      1024,
      1024
    ],
    "algo.policy_hidden": [
      1024,
      512,
      256,
      128
    ],
    "algo.critic_hidden": [
      256,
      128
    ],
    "algo.wm_window": 8,
    "algo.horizon": 32,
    "algo.amp": "bf16",
    "env.commands.motion.goal_frames": 10,
    "env.commands.motion.context_dim": 27,
    "env.commands.motion.motion_files": [
      "src/unisupermimic/assets/motions/rpo/backflip_reference.csv"
    ],
    "env.commands.motion.mjcf_path": "src/unisupermimic/assets/robots/rpo/supermimic_coupled.xml"
  }
}
